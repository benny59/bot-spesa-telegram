<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvModelloNome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivModelloShare"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="4dp"
            android:contentDescription="Condividi modello"
            android:src="@drawable/ic_share"
            android:tint="@android:color/darker_gray" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvModelloArticoli"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:ellipsize="end"
        android:paddingTop="4dp"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnModelloAggiungi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aggiungi"
            android:textColor="@android:color/holo_blue_dark"
            android:padding="8dp" />

        <TextView
            android:id="@+id/btnModelloModifica"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modifica"
            android:textColor="@android:color/darker_gray"
            android:padding="8dp" />

        <TextView
            android:id="@+id/btnModelloElimina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elimina"
            android:textColor="@android:color/holo_red_dark"
            android:padding="8dp" />
    </LinearLayout>
</LinearLayout>
