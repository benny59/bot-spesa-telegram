<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Preferiti"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <Button
            android:id="@+id/btnBackupPreferiti"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/backup" />

        <Button
            android:id="@+id/btnRipristinaPreferiti"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ripristina" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPreferitiVuoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="Nessun preferito"
        android:textColor="#888888"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPreferiti"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp" />
</LinearLayout>