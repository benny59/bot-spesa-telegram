<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvPreferitoStatus"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/circle_initials"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPreferitoDescrizione"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvPreferitoCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivPreferitoLink"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/apri_link_prodotto"
        android:src="@drawable/ic_share"
        android:tint="#FF7A00"
        android:visibility="gone" />
</LinearLayout>