<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/quick_add_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Aggiungi…"
        android:minHeight="72dp"
        android:textSize="22sp"
        android:imeOptions="actionSend"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:singleLine="true" />

    <TextView
        android:id="@+id/quick_add_dest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="16dp"
        android:paddingBottom="10dp"
        android:textColor="#1976D2"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/quick_add_cat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="#1976D2"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/quick_add_solo"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:background="@drawable/quick_add_solo_bg"
            android:contentDescription="Solo per me"
            android:gravity="center"
            android:text="👤"
            android:textSize="22sp" />
    </LinearLayout>
</LinearLayout>
